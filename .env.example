# Resend API key (https://resend.com/api-keys) — required to send booking emails
RESEND_API_KEY=

# Where booking-form leads are delivered (the owner's inbox)
BOOKING_TO_EMAIL=

# Verified sender address; use onboarding@resend.dev until a domain is verified in Resend
BOOKING_FROM_EMAIL=onboarding@resend.dev

# Google Sheet + Gmail lead pipeline (docs/GOOGLE-SHEET-SETUP.md).
# The Apps Script web app URL that appends each lead to the "Ascent Leads"
# sheet and emails the owner. Leads still work without it; failures only log.
LEADS_WEBHOOK_URL=
# Must match the SECRET constant pasted into the Apps Script.
LEADS_WEBHOOK_SECRET=
