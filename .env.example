# Booking fallback form — the serverless email route (app/api/book/route.ts).
# Without these, submissions are logged to the Vercel function log under
# [BOOKING_ROUTE_UNCONFIGURED] instead of being emailed. Set them BEFORE launch.
RESEND_API_KEY=
BOOKING_TO_EMAIL=
# Must be a verified sender/domain in Resend. Defaults to Resend's onboarding
# sender if unset (fine for testing, not for production).
BOOKING_FROM_EMAIL=

# Canonical origin used in metadata, sitemap, robots, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://ascentcas.com
